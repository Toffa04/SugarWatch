@startuml
object PatientController {
/patient + getAllPatients(): ResponseEntity<?>
/patient/{id} + getPatientById(Integer id): ResponseEntity<?>
/patient/medic/{medicId} + getPatientByMedic(Integer medicId): ResponseEntity<?>
/patient + createPatient(CreatePatientRequest request): ResponseEntity<?>
/patient/{id} + updatePatient(Integer patientId, Patient patient): ResponseEntity<?>
/patient/{id}/risk-factors + updateRiskFactors(Integer id, RiskFactorsRequest request): ResponseEntity<?>
/patient/{patientId}/medic/{medicId} + assignMedic(Integer patientId, Integer medicId): ResponseEntity<?>
/patient/{id} + deletePatient(Integer id): ResponseEntity<?>  
}

object MedicController {
/medic + getAllMedics(): ResponseEntity<?>
/medic/{id} + getMedicById(Integer id): ResponseEntity<?>
/medic/{id}/patients + getPatientsByMedic(Integer id): ResponseEntity<?>
/medic/{id}/patients/high-glycemia + getPatientsWithHighGlycemia(Integer id): ResponseEntity<?>
/medic + createMedic(CreateMedicRequest request): ResponseEntity<?>
/medic/{id} updateMedic(Integer id, Medic medic): ResponseEntity<?>
/medic/{id} + deleteMedic(Integer id): ResponseEntity<?>  
}

object TherapyController {
  /therapy/patient/{patientId} + getByPatient(Integer patientId): ResponseEntity<?>
  /therapy/patient/{patientId}/active + getActiveTherapy(Integer patientId): ResponseEntity<?>
  /therapy/patient/{patientId}/suspended + getSuspendedTherapy(Integer patientId): ResponseEntity<?>
  /therapy/patient/{patientId}/modified + getModifiedTherapy(Integer patientId): ResponseEntity<?>
  /therapy/{id} + getById(Integer id): ResponseEntity<?>
  /therapy/patient/{patientId}/medic/{medicId} + createTherapy(Integer patientId, Integer medicId, Therapy therapy): ResponseEntity<?>
  /therapy/{id}/medic/{medicId} + updateTherapy(Integer id, Integer medicId, Therapy therapy): ResponseEntity<?>
  /therapy/{id}/suspended/medic/{medicId} + suspendedTherapy(Integer id, Integer medicId): ResponseEntity<?>
  /therapy/{id} + deleteTherapy(Integer id): ResponseEntity<?>
}

object NotificationController {
  /notification/user/{userId} + getByUser(Integer userId): ResponseEntity<?>
  /notification/user/{userId}/unread + getUnreadByUser(Integer userId): ResponseEntity<?>
  /notification/{id} + getById(Integer id): ResponseEntity<?>
  /notification/{id}/seen + markAsSeen(Integer id): ResponseEntity<?>
  /notification/user/{userId}/seen + markAllAsSeen(Integer userId): ResponseEntity<?>
  /notification/{id} + deleteNotification(Integer id): ResponseEntity<?>
}

object MedicChangeLogController {
  /medic-change-log + getAllLogs(): ResponseEntity<?>
  /medic-change-log/{id} + getLogById(Integer id): ResponseEntity<?>
  /medic-change-log/medic/{medicId} + getLogsByMedic(Integer medicId): ResponseEntity<?>
  /medic-change-log/patient/{patientId} + getLogsByPatient(Integer patientId): ResponseEntity<?>
  /medic-change-log/medic/{medicId}/patient/{patientId} + getLogsByMedicAndPatient(Integer medicId, Integer patientId): ResponseEntity<?>
  /medic-change-log/type/{entityType} + getLogsByEntityType(String entityType): ResponseEntity<?>
  /medic-change-log + createLog(CreateMedicChangeLogRequest request): ResponseEntity<?>
  /medic-change-log/{id} + deleteLog(Integer id): ResponseEntity<?>
}
PatientController -[hidden]down-> MedicController
MedicController -[hidden]down-> TherapyController
TherapyController -[hidden]down-> NotificationController
NotificationController -[hidden]down-> MedicChangeLogController
@enduml

